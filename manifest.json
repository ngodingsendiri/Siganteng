{
  "manifest_version": 3,
  "name": "Siganteng",
  "version": "1.0.13",
  "description": "Siganteng — bulk input kolektif SIKEREN, lebih ganteng dari Sikeren. Kalender klik, flat minimalis.",
  "permissions": ["storage"],
  "host_permissions": ["https://sikeren.jemberkab.go.id/*"],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://sikeren.jemberkab.go.id/kinerja-harian/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Siganteng",
    "default_popup": "src/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://sikeren.jemberkab.go.id/*"]
    }
  ]
}
